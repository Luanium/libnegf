# Visualize Figs. 4-6 style heterointerface results.
# Run from the libnegf repository root:
#   gnuplot build/tests/f90hetero_interface/plot_hetero_interface.gnuplot
#
# Inputs are generated by the f90hetero_interface test in build/tests/...
# The spectral files contain (band, z, E, j); blank lines delimit energy scans.
# The band-edge file is written by the test from its actual ec_z/ev_z arrays.

reset
set encoding utf8
set terminal qt enhanced font "Arial,12"

DATA_DIR = "../../build/tests/f90hetero_interface"
SPEC_A = DATA_DIR . "/hetero_interface_spec_A.dat"
SPEC_B = DATA_DIR . "/hetero_interface_spec_B.dat"
SPEC_C = DATA_DIR . "/hetero_interface_spec_C.dat"
JINT   = DATA_DIR . "/hetero_interface_jint.dat"
BANDS  = DATA_DIR . "/hetero_interface_band_edges.dat"

# Manually selected symmetric spectral-current scale [mA/(cm^2 eV)].
# Change this value to adjust the color saturation and colorbar limits.
CBMAX = 50.0

# Match Fig. 4: negative current -> yellow/orange/red; zero -> white;
# positive current -> light/dark blue.
set palette defined (-CBMAX "#ffff00", -0.67*CBMAX "#ff9900", \
                     -0.33*CBMAX "#ff5555", 0 "white", \
                      0.33*CBMAX "#aaaaff", 0.67*CBMAX "#5555bb", \
                      CBMAX "#333366")
set cbrange [-CBMAX:CBMAX]
set cbtics 20
# Paint the supplied grid directly; do not interpolate or re-grid it.
set pm3d map interpolate 0,0
set view map

# Current-density curves: paper-like colors and open point symbols.
set style line 1 lc rgb "#cc00cc" lw 1.5 pt 6 ps 0.55
set style line 2 lc rgb "#009966" lw 1.5 pt 4 ps 0.55
set style line 3 lc rgb "#55bbee" lw 1.5 pt 8 ps 0.55

set grid
set tics out nomirror
set border linewidth 1
set xrange [0:19.5]

set multiplot layout 2,3 rowsfirst title "Defective AlGaAs-GaAs hetero-interface"

# ---------------------------------------------------------------------------
# Top row: spectral current maps. The two black curves are Ec(z) and Ev(z).
# ---------------------------------------------------------------------------
set xlabel "Position z (nm)"
set ylabel "Energy E (eV)"
set cblabel "Spectral current density j(E,z) [mA/(cm^2 eV)]"
set yrange [-0.2:2.2]
set key off
set colorbox vertical

set title "Fig. 4(a) - dark, with defect"
splot SPEC_A using 2:3:4 with pm3d notitle, \
      BANDS using 1:2:(0) with lines lc rgb "black" lw 2.0 notitle, \
      BANDS using 1:3:(0) with lines lc rgb "black" lw 2.0 notitle

set title "Fig. 5(a) - illumination, no defect"
splot SPEC_B using 2:3:4 with pm3d notitle, \
      BANDS using 1:2:(0) with lines lc rgb "black" lw 2.0 notitle, \
      BANDS using 1:3:(0) with lines lc rgb "black" lw 2.0 notitle

set title "Fig. 6(a) - defect + illumination"
splot SPEC_C using 2:3:4 with pm3d notitle, \
      BANDS using 1:2:(0) with lines lc rgb "black" lw 2.0 notitle, \
      BANDS using 1:3:(0) with lines lc rgb "black" lw 2.0 notitle

# ---------------------------------------------------------------------------
# Bottom row: energy-integrated electron, hole and total current densities.
# jint columns: z, (je,jh,jtot)_A, (je,jh,jtot)_B, (je,jh,jtot)_C.
# ---------------------------------------------------------------------------
unset colorbox
set xlabel "Position z (nm)"
set ylabel "Current density j (mA/cm^2)"
set key right center

set title "Fig. 4(b)"
set yrange [-0.01:2]
plot JINT using 1:2 with linespoints ls 1 title "electron", \
     JINT using 1:3 with linespoints ls 2 title "hole", \
     JINT using 1:4 with linespoints ls 3 title "total"

set key right top

set title "Fig. 5(b)"
set yrange [-4:2]
plot JINT using 1:5 with linespoints ls 1 title "electron", \
     JINT using 1:6 with linespoints ls 2 title "hole", \
     JINT using 1:7 with linespoints ls 3 title "total"

set title "Fig. 6(b)"
set yrange [-4:2]
plot JINT using 1:8 with linespoints ls 1 title "electron", \
     JINT using 1:9 with linespoints ls 2 title "hole", \
     JINT using 1:10 with linespoints ls 3 title "total"

unset multiplot

pause mouse close